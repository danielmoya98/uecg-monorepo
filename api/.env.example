# Servidor & Entorno
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Base de Datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uecg_db?schema=public"

# Redis & Colas BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_in_production
JWT_REFRESH_EXPIRATION=7d
COOKIE_DOMAIN=localhost

# Clave de Encriptación PII (32 bytes hex / base64)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Correo Electrónico (Nodemailer / OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@uecg.edu.bo
SMTP_PASS=app_password_here
SMTP_FROM="UECG Plataforma <no-reply@uecg.edu.bo>"
